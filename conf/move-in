#!/bin/zsh

set -ex

# Create passwd entry for arbitrary UID (OpenShift compatibility)
if ! whoami &> /dev/null; then
  if [ -w /etc/passwd ]; then
    echo "user:x:$(id -u):0::/opt:/bin/zsh" >> /etc/passwd
  fi
fi

cd ~/workspace
gh repo clone workspace .

# Restore Claude Code transcripts from S3 (replaces the old claude.tar.gz blob).
# pull-all aggregates every container's sessions, dedups by session id, and
# builds the FTS search index. --dest lands them in ~/.claude/projects so they
# are resumable (/resume), not just searchable.
mkdir -p ~/.claude/projects
python3 ./bin/pull-all-conversations.py --dest ~/.claude/projects || true

./move-in
